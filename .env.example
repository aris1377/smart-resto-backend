DATABASE_URL=

JWT_SECRET=
JWT_EXPIRES_IN=
CORS_ORIGINS=
REFRESH_TOKEN_EXPIRES_DAYS=

ADMIN_API_KEY=
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
# Stol QR kodi shu manzilga ishora qiladi: <QR_BASE_URL>/<qrCodeToken>.
# Mijoz telefoni ochadigan FRONTEND sahifasi boʻlishi kerak, backend emas.
# Lokalda telefondan sinash uchun localhost emas, kompyuterning LAN IP si:
#   QR_BASE_URL=http://192.168.0.5:5173/t
# Prodda: https://menu.smartresto.uz/t
QR_BASE_URL=http://localhost:5173/t

REDIS_HOST=
REDIS_PORT=

S3_ENDPOINT=http://localhost:9200
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=smart-resto
S3_PUBLIC_URL=http://localhost:9200

# FCM push. Firebase Console > Project Settings > Service accounts > Generate key.
# Private key bitta qatorda, qo'shtirnoq ichida; yangi qator o'rniga \n yoziladi.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
